+def live_loop(adapter):
+    """A RUNNING loop on a daemon thread — what connect() leaves on the adapter — so the
+    Pub/Sub-callback-thread path really round-trips through run_coroutine_threadsafe."""
+    loop = asyncio.new_event_loop()
+    thread = threading.Thread(target=loop.run_forever, daemon=True)
+    thread.start()
+    adapter._loop = loop
+    yield loop
+    loop.call_soon_threadsafe(loop.stop)
+    thread.join(timeout=5)
+    loop.close()
