+    async def _handle_card_click(self, envelope: dict[str, Any]) -> None:
+        """Resolve a clarify prompt from a CARD_CLICKED Pub/Sub event.
+
+        Envelope shapes: native ``{"type": "CARD_CLICKED", ...}``, Workspace
+        add-ons ``{"chat": {"cardClickPayload": ...}}``, or the Chat add-ons
+        envelope ``{"chat": {"buttonClickedPayload": ...}}`` (parameters on
+        ``commonEventObject.parameters``). The clicked widget's
+        parameters carry ``clarify_id`` + ``choice`` (set at render time).
+        Mirrors the Slack adapter's contract: resolve via clarify_gateway,
+        "other" flips to text-capture, expired id → honest expiry note.
+        """
+        try:
+            chat = envelope.get("chat") or {}
+            payload = chat.get("cardClickPayload") or chat.get("buttonClickedPayload") or envelope
+            message = payload.get("message") or {}
+            user = (((payload.get("user") or payload.get("common") or {}).get("displayName"))
+                    or (chat.get("user") or {}).get("displayName")) or "User"
+            # Parameters may be flat key/value pairs or Chat's list form.
+            params: dict[str, str] = {}
+
+            def _collect(obj: Any) -> None:
+                if not isinstance(obj, dict):
+                    return
+                raw = obj.get("parameters")
+                if isinstance(raw, dict):  # flat {k: v} form (add-on commonEventObject)
+                    params.update({str(k): str(v) for k, v in raw.items()})
+                elif isinstance(raw, list):  # Chat native [{key, value}] form
+                    for item in raw:
+                        if isinstance(item, dict) and "key" in item:
+                            params[str(item["key"])] = str(item.get("value", ""))
+
+            _collect(payload.get("action") or {})
+            _collect(payload.get("actionResponse") or {})
+            clicked = payload.get("clickedWidget") or {}
+            if isinstance(clicked, dict):
+                _collect(clicked)
+            common = payload.get("commonEventObject") or {}
+            _collect(common)
+            # Add-ons envelope: parameters ride the TOP-LEVEL commonEventObject,
+            # not the buttonClickedPayload sub-dict.
+            _collect(envelope.get("commonEventObject") or {})
+            if not params:
+                # Native event shape: parameters ride the clicked button directly.
+                for w in ([payload.get("parameters")] if isinstance(payload.get("parameters"), dict) else []):
+                    params.update({k: str(v) for k, v in w.items()})
+            clarify_id = params.get("clarify_id", "")
+            choice = params.get("choice", "")
+            if not clarify_id:
+                logger.info("[GoogleChat] CARD_CLICKED without clarify parameters; ignored")
+                return
+            from tools import clarify_gateway as _cg
+            msg_name = message.get("name") or ""
+
+            async def _ack_card(text: str) -> None:
+                if not msg_name:
+                    return
+                card_id = f"clarify-{clarify_id}"
+                card = card_spec_to_cards_v2({
+                    "card_id": card_id, "header": {"title": t("platform.google_chat.clarify.header")},
+                    "sections": [{"widgets": [{"type": "text", "text": text}]}],
+                })
+                try:
+                    await self._patch_message(msg_name, {"cardsV2": [card]})
+                except Exception as exc:  # the card patch is cosmetic
+                    logger.debug("[GoogleChat] clarify card patch failed: %s", exc)
+
+            expired_text = t("platform.google_chat.clarify.expired")
+            if choice == "__other__":
+                if _cg.mark_awaiting_text(clarify_id):
+                    await _ack_card(t("platform.google_chat.clarify.awaiting", user=user))
+                else:
+                    await _ack_card(expired_text)
+                return
+            if _cg.resolve_gateway_clarify(clarify_id, choice):
+                await _ack_card(t("platform.google_chat.clarify.resolved", user=user, choice=choice))
+                logger.info("[GoogleChat] Card click resolved clarify (id=%s, choice=%.60r)", clarify_id, choice)
+            else:
+                await _ack_card(expired_text)
+                logger.warning("[GoogleChat] clarify resolve failed for %s (expired/reset)", clarify_id)
+        except Exception:
+            logger.exception("[GoogleChat] CARD_CLICKED handler error")
+
