+    def _handle_click_bounded(self, envelope: dict[str, Any]) -> bool:
+        """Run one CARD_CLICKED handler to completion before the ack decision.
+
+        Awaiting the handler converts click processing from at-most-once to
+        at-least-once: fire-and-forget submit + immediate ack silently dropped
+        clicks that hit a transient failure (Chat API 5xx, network blip) —
+        eternal loading bar for the user, a log line on our side. Google's own
+        pub-sub sample acks only after the handler returns, so its library
+        auto-nacks failed events and Pub/Sub redelivers; this matches that
+        semantics. Returns True -> ack, False -> nack (redelivery).
+
+        Safe under redelivery: the card patch rewrites identical content and
+        an already-resolved prompt hits the polite expired branch.
+        """
+        from concurrent.futures import wait as _cf_wait
+
+        if not self._loop_accepts_callbacks(self._loop):
+            return False  # shutdown race: avoid creating a coroutine that can't be scheduled
+        future = self._submit_on_loop(self._handle_card_click(envelope), track=False)
+        if future is None:
+            # Loop not accepting (shutdown race): redeliver on next connect.
+            return False
+        done, _ = _cf_wait({future}, timeout=self._CLICK_HANDLER_TIMEOUT)  # well under the ack deadline
+        if future in done:
+            exc = future.exception()  # None when the handler completed cleanly
+            if exc is None:
+                return True
+            logger.warning("[GoogleChat] card click handler failed; nacking for Pub/Sub redelivery",
+                           exc_info=exc)
+        else:
+            # A timeout must not leave the original handler running uncoordinated under
+            # a nack — redelivery would then run a SECOND handler concurrently. Cancel
+            # the task BEFORE the nack: a run_coroutine_threadsafe future cancels even
+            # mid-await (CancelledError lands at the handler's next await point).
+            cancelled = future.cancel()
+            logger.error(
+                "[GoogleChat] card click handler exceeded %ss; %s; nacking for redelivery", self._CLICK_HANDLER_TIMEOUT,
+                "handler task cancelled" if cancelled else "cancel refused (task finishing; redelivery may duplicate)")
+        # Bound the redelivery rate: a bare nack redelivers near-immediately,
+        # so a deterministic bug would hot-loop the subscription. The backoff
+        # keeps a retry every few seconds until the prompt expires and the handler
+        # starts acking via the expired branch.
+        time.sleep(self._CLICK_NACK_BACKOFF)
+        return False
+
