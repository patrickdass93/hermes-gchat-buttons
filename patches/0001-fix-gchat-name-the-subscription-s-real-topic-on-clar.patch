+++ b/tests/gateway/test_google_chat_card_click.py
@@ -0,0 +1,95 @@
+"""Google Chat card clicks over Pub/Sub: topic-path derivation, payload-shape routing, clarify
+resolution, and ack semantics.
+
+Importing ``tests.gateway.test_google_chat`` first installs the google-* stubs into ``sys.modules``
+before the adapter is imported (the real libraries are optional deps).
+"""
+import asyncio
+import json
+import logging
+import threading
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from tests.gateway.test_google_chat import adapter  # importing installs the google stubs first
+import plugins.platforms.google_chat.adapter as _gc_mod
+
+SUB = "projects/test-project/subscriptions/gchat-acme-hermes-sub"
+REAL_TOPIC = "projects/test-project/topics/gchat-acme-hermes"  # the real binding, no "-sub"
+NAME_TRANSFORM = "projects/test-project/topics/gchat-acme-hermes-sub"
+
+
+def _click_envelope(clarify_id="cid-1", choice="Simple", *, msg_name="spaces/S/messages/M.CLARIFY"):
+    """Native CARD_CLICKED envelope: the clicked button carries the parameters."""
+    return {
+        "type": "CARD_CLICKED",
+        "commonEventObject": {},
+        "user": {"name": "users/12345", "displayName": "Ann", "type": "HUMAN"},
+        "space": {"name": "spaces/S"},
+        "message": {"name": msg_name, "text": "Pick one", "space": {"name": "spaces/S"}},
+        "action": {"actionMethodName": "click", "parameters": [
+            {"key": "clarify_id", "value": clarify_id}, {"key": "choice", "value": choice}]},
+    }
+
+
+# ===========================================================================
+# Topic-path derivation
+# ===========================================================================
+
+
+class TestClickTopicDerivation:
+    """A Pub/Sub-connected Chat app publishes CARD_CLICKED to the topic NAMED BY THE BUTTON, so the
+    button action must carry the subscription's real topic — a name-transform guess 404s at publish
+    whenever the topic is off-convention (``<name>-sub`` bound to ``<name>``)."""
+
+    @pytest.mark.asyncio
+    async def test_check_subscription_captures_the_real_topic_binding(self, adapter, monkeypatch, caplog):
+        subscriber = MagicMock()
+        subscriber.get_subscription.return_value = SimpleNamespace(topic=REAL_TOPIC)
+        monkeypatch.setattr(_gc_mod, "pubsub_v1", MagicMock(SubscriberClient=MagicMock(return_value=subscriber)))
+
+        with caplog.at_level(logging.WARNING):
+            assert await adapter._check_subscription(SUB, credentials=MagicMock()) is True
+
+        assert REAL_TOPIC != NAME_TRANSFORM, "fixture must be off-convention to prove the point"
+        assert adapter._click_topic_path == REAL_TOPIC
+        assert "no topic field" not in caplog.text
+
+    @pytest.mark.asyncio
+    async def test_check_subscription_falls_back_to_the_name_transform_without_a_topic_field(
+            self, adapter, monkeypatch, caplog):
+        subscriber = MagicMock()
+        subscriber.get_subscription.return_value = SimpleNamespace(topic="")  # mock / legacy path
+        monkeypatch.setattr(_gc_mod, "pubsub_v1", MagicMock(SubscriberClient=MagicMock(return_value=subscriber)))
+
+        with caplog.at_level(logging.WARNING):
+            assert await adapter._check_subscription(SUB, credentials=MagicMock()) is True
+
+        assert adapter._click_topic_path == NAME_TRANSFORM
+        assert "derived from subscription name" in caplog.text
+
+    @pytest.mark.asyncio
+    async def test_buttons_carry_the_real_topic_not_the_name_transform(self, adapter):
+        adapter._click_topic_path = REAL_TOPIC
+        adapter._create_message = AsyncMock(return_value=MagicMock(success=True, message_id="m/1", error=None))
+
+        assert (await adapter.send_clarify("spaces/S", "Pick", ["Simple", "Plain"], "c1", "sk")).success
+
+        buttons = adapter._create_message.await_args.args[1]["cardsV2"][0]["card"]["sections"][0]["widgets"][1]["buttonList"]["buttons"]
+        assert {b["onClick"]["action"]["function"] for b in buttons} == {REAL_TOPIC}
+        assert {"key": "clarify_id", "value": "c1"} in buttons[0]["onClick"]["action"]["parameters"]
+        assert {"key": "choice", "value": "Simple"} in buttons[0]["onClick"]["action"]["parameters"]
+
+    @pytest.mark.asyncio
+    async def test_http_callback_mode_keeps_the_bare_action_name(self, adapter):
+        """No subscription → no topic to publish to; HTTP mode routes by actionMethodName."""
+        adapter._click_topic_path = None
+        adapter._subscription_path = None
+        adapter._create_message = AsyncMock(return_value=MagicMock(success=True, message_id="m/1", error=None))
+
+        await adapter.send_clarify("spaces/S", "Pick", ["Simple"], "c1", "sk")
+
+        buttons = adapter._create_message.await_args.args[1]["cardsV2"][0]["card"]["sections"][0]["widgets"][1]["buttonList"]["buttons"]
+        assert {b["onClick"]["action"]["function"] for b in buttons} == {"hermes_clarify"}
