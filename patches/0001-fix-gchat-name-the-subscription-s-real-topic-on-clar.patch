From be2056ac9e9eac0044db86f03688dad3c018d121 Mon Sep 17 00:00:00 2001
From: patrickdass93 <patrickdass93@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:07:30 +0800
Subject: [PATCH 1/4] fix(gchat): name the subscription's real topic on clarify
 buttons

A Pub/Sub-connected Chat app publishes the CARD_CLICKED event to the topic
named by the button's onClick.action.function. The clarify card sent a bare
function name ("hermes_clarify"), an invalid resource name: the click died at
publish with "Invalid resource name" in the project's gsuiteaddons error log,
the user saw "<app> is unable to process your request", and nothing reached
the gateway.

Buttons now carry the full topic path. At connect, _check_subscription keeps
the topic field of the subscriptions().get() response in _click_topic_path;
the "/subscriptions/" -> "/topics/" name transform stays only as a fallback,
because it is wrong whenever the topic is off-convention (a "<name>-sub"
subscription bound to a "<name>" topic 404s on every click). HTTP-callback
mode has no topic and keeps the bare actionMethodName.
---
 plugins/platforms/google_chat/adapter.py     | 33 ++++++-
 tests/gateway/test_google_chat.py            |  4 +-
 tests/gateway/test_google_chat_card_click.py | 95 ++++++++++++++++++++
 3 files changed, 129 insertions(+), 3 deletions(-)
 create mode 100644 tests/gateway/test_google_chat_card_click.py

diff --git a/plugins/platforms/google_chat/adapter.py b/plugins/platforms/google_chat/adapter.py
index 3b792001a6..b2802ab5ef 100644
--- a/plugins/platforms/google_chat/adapter.py
+++ b/plugins/platforms/google_chat/adapter.py
@@ -406,6 +406,7 @@ class GoogleChatAdapter(BasePlatformAdapter):
         _load_google_modules()
         self._subscriber = self._chat_api = self._credentials = self._streaming_pull_future = None
         self._project_id = self._subscription_path = self._bot_user_id = None  # bot id is users/{id}
+        self._click_topic_path: Optional[str] = None  # REAL topic the subscription binds to; card clicks publish here
         self._supervisor_task: Optional[asyncio.Task] = None
         self._loop: Optional[asyncio.AbstractEventLoop] = None
         # The profile scope this adapter was connected under (multiplex: HERMES_HOME override + secret
@@ -624,13 +625,26 @@ class GoogleChatAdapter(BasePlatformAdapter):
         }
         self._subscriber = pubsub_v1.SubscriberClient(credentials=credentials)
         try:
-            await asyncio.to_thread(lambda: self._subscriber.get_subscription(request={"subscription": subscription_path}))
+            sub = await asyncio.to_thread(lambda: self._subscriber.get_subscription(request={"subscription": subscription_path}))
         except (gax_exceptions.NotFound, gax_exceptions.PermissionDenied) as exc:
             code, message = fatals[type(exc)]
             self._set_fatal_error(code=code, message=message, retryable=False)
             return False
         except Exception as exc:
             return self._connect_failed("[GoogleChat] subscription.get failed: %s", exc, "subscription_check", retryable=True)
+        # The get_subscription response carries the subscription's REAL topic
+        # binding. Button clicks publish to the topic named by the button action,
+        # and deriving it from the subscription NAME ("/subscriptions/" →
+        # "/topics/") 404s whenever the topic is off-convention: every click
+        # dies at publish and the user sees an "app is unable to process your
+        # request" card with nothing in the gateway log. Prefer the authoritative
+        # field; keep the name transform only as a fallback for mock/legacy paths.
+        real_topic = getattr(sub, "topic", "") or ""
+        if real_topic.startswith("projects/"):
+            self._click_topic_path = real_topic
+        else:
+            self._click_topic_path = subscription_path.replace("/subscriptions/", "/topics/") if subscription_path else None
+            logger.warning("[GoogleChat] no topic field on subscription response; clarify click topic derived from subscription name")
         return True
 
     async def connect(self, *, is_reconnect: bool = False) -> bool:
@@ -1156,8 +1170,23 @@ class GoogleChatAdapter(BasePlatformAdapter):
         if not choices:
             return await super().send_clarify(chat_id, question, choices, clarify_id, session_key, metadata)
 
+        # Pub/Sub-connected apps: Chat publishes the CARD_CLICKED event to the
+        # topic named by the button's action function — a bare function name
+        # fails with "Invalid resource name" (gsuiteaddons error log) and the
+        # user sees "app is unable to process your request". Use the full
+        # topic path so the click lands in the existing subscription — the REAL
+        # binding captured at connect (a name-derived path 404s when the topic
+        # is off-convention; see _check_subscription).
+        # HTTP-callback mode keeps the bare function name (actionMethodName).
+        if self._click_topic_path:
+            click_function = self._click_topic_path
+        elif self._subscription_path:
+            click_function = self._subscription_path.replace("/subscriptions/", "/topics/")
+        else:
+            click_function = "hermes_clarify"
+
         def _button(text: str, choice: str) -> dict[str, Any]:
-            return {"text": text, "action": "hermes_clarify", "parameters": {"clarify_id": clarify_id, "choice": choice}}
+            return {"text": text, "action": click_function, "parameters": {"clarify_id": clarify_id, "choice": choice}}
         clean = [s for s in (str(c).strip() for c in choices) if s]
         # Card buttons clip long labels with no tooltip (#78115): list the full options in the
         # text widget and label the buttons positionally when any option is that wide.
