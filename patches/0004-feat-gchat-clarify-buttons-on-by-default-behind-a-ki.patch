+@pytest.fixture()
+def base_clarify(monkeypatch):
+    """The base-class numbered-text prompt, so tests can see when the card path defers to it."""
+    mock = AsyncMock(return_value=MagicMock(success=True, message_id="text/1", error=None))
+    monkeypatch.setattr(BasePlatformAdapter, "send_clarify", mock)
