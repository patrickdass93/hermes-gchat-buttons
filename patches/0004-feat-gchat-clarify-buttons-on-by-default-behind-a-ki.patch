@@ -1278,6 +1282,8 @@ class GoogleChatAdapter(BasePlatformAdapter):
     ) -> SendResult:
         if not choices:
             return await super().send_clarify(chat_id, question, choices, clarify_id, session_key, metadata)
+        if not self._clarify_buttons:
+            return await super().send_clarify(chat_id, question, choices, clarify_id, session_key, metadata)
 
         # Pub/Sub-connected apps: Chat publishes the CARD_CLICKED event to the
         # topic named by the button's action function — a bare function name
@@ -1314,10 +1320,17 @@ class GoogleChatAdapter(BasePlatformAdapter):
         })
         if numbered:
             card["card"]["sections"][0]["widgets"][0]["textParagraph"]["text"] += f"\n\n{numbered}"
+        # Advertise the typed path on the card as well: the click publish leg is
+        # Google-side and can fail without a trace, while a typed reply always resolves.
+        card["card"]["sections"][0]["widgets"][0]["textParagraph"]["text"] += (
+            f"\n\n{t('gateway.clarify.hint_single')}")
         result = await self.send_card(chat_id, card, metadata=metadata)
         if result.success:
             self._clarify_state[clarify_id] = session_key
             return result
+        # The text fallback below is a success from the caller's side, so this is the
+        # only place a failed card send is visible: log it, never swallow it.
+        logger.warning("[GoogleChat] clarify card failed (%s); falling back to the text prompt", result.error)
         return await super().send_clarify(chat_id, question, choices, clarify_id, session_key, metadata)
 
