+from tests.gateway.test_google_chat import GoogleChatAdapter, adapter, _make_pubsub_message  # importing installs the google stubs first
 import plugins.platforms.google_chat.adapter as _gc_mod
 import tools.clarify_gateway as _cg
 
@@ -298,3 +298,97 @@ class TestClickAckSemantics:
