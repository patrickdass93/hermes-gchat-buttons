+
+
+# ===========================================================================
+# Payload-shape routing: the ce-type string is not stable across Chat surfaces
+# ===========================================================================
+
+WORKSPACE_CLICK = {"chat": {"cardClickPayload": {  # Workspace add-on shape
+    "user": {"displayName": "Cy"}, "space": {"name": "spaces/S"}, "message": {"name": MSG_NAME},
+    "action": {"parameters": [{"key": "clarify_id", "value": "cid-w"}, {"key": "choice", "value": "Plain"}]},
+}}}
+ADDONS_CLICK = {"commonEventObject": {"parameters": {"clarify_id": "cid-a", "choice": "Plain"}},  # Chat add-ons shape
+                "chat": {"user": {"displayName": "Bo"},
+                         "buttonClickedPayload": {"space": {"name": "spaces/S"}, "message": {"name": MSG_NAME}}}}
+
+
+class TestLooksLikeCardClick:
+    @pytest.mark.parametrize("envelope", [
+        _click_envelope(),            # native {"type": "CARD_CLICKED", ...}
+        WORKSPACE_CLICK,              # {"chat": {"cardClickPayload": ...}}
+        ADDONS_CLICK,                 # {"chat": {"buttonClickedPayload": ...}} + envelope-level commonEventObject
+    ], ids=["native", "workspace-add-on", "chat-add-ons"])
+    def test_the_three_observed_shapes_are_recognized(self, envelope):
+        assert GoogleChatAdapter._looks_like_card_click(envelope) is True
+
+    @pytest.mark.parametrize("envelope", [
+        {}, None, "CARD_CLICKED", [{"type": "CARD_CLICKED"}],
+        {"type": "MESSAGE", "message": {"text": "hi"}},
+        {"chat": {"messagePayload": {"message": {"text": "hi"}}}},
+        {"commonEventObject": {"parameters": {"clarify_id": "x"}}},  # no click payload under chat
+    ], ids=["empty", "none", "str", "list", "native-message", "workspace-message", "parameters-only"])
+    def test_everything_else_is_not_a_click(self, envelope):
+        assert GoogleChatAdapter._looks_like_card_click(envelope) is False
+
+
+class TestClickRoutingByShape:
+    def test_add_ons_click_with_an_empty_ce_type_is_routed_not_dropped(self, adapter, live_loop, patch, pending, caplog, monkeypatch):
+        """The third shape: ce-type is EMPTY on that surface, so the ce-type router misses it and
+        only the payload gate sends it to the handler. Its parameters ride the ENVELOPE-level
+        commonEventObject, not the buttonClickedPayload sub-dict."""
+        pending("cid-a")
+        handler_calls = []
+
+        real = adapter._handle_card_click
+
+        async def spy(envelope):
+            handler_calls.append(envelope)
+            await real(envelope)
+
+        monkeypatch.setattr(adapter, "_handle_card_click", spy)
+        with caplog.at_level(logging.INFO):
+            adapter._on_pubsub_message(_click_msg(ADDONS_CLICK, ce_type=""))
+
+        assert handler_calls == [ADDONS_CLICK]
+        assert "CARD_CLICKED via payload-shape fallback (ce-type='')" in caplog.text
+        assert _patched_text(adapter) == _card_text("✅ Bo: Plain")
+        assert _cg.get_pending("cid-a") is None
+
+    def test_workspace_shape_with_a_mismatched_ce_type_is_routed_too(self, adapter, live_loop, patch, pending):
+        pending("cid-w")
+        adapter._on_pubsub_message(_click_msg(WORKSPACE_CLICK, ce_type="some.future.event.type"))
+        assert _patched_text(adapter) == _card_text("✅ Cy: Plain")
+
+    def test_message_with_an_unfamiliar_ce_type_still_dispatches(self, adapter, live_loop):
+        """The loud-drop branch must not swallow real messages whose ce-type we don't know."""
+        from tests.gateway.test_google_chat import _make_chat_envelope
+
+        msg = _make_pubsub_message(_make_chat_envelope(text="hi"), attributes={"ce-type": "some.future.event.type"})
+        adapter._on_pubsub_message(msg)
+        msg.ack.assert_called_once()
+        deadline = time.monotonic() + 5
+        while adapter.handle_message.await_count == 0 and time.monotonic() < deadline:
+            time.sleep(0.01)
+        assert adapter.handle_message.await_count == 1
+
+    def test_unrouted_event_is_logged_with_ce_type_and_redacted_payload_before_the_ack(
+            self, adapter, live_loop, monkeypatch, caplog):
+        import agent.redact
+
+        monkeypatch.setattr(agent.redact, "redact_sensitive_text", lambda text: f"<redacted:{len(text)}>")
+        monkeypatch.setattr(adapter, "_handle_card_click", AsyncMock())
+        envelope = {"chat": {"reactionPayload": {"emoji": "👍", "secret": "hunter2"}}}
+        msg = _click_msg(envelope, ce_type="google.workspace.chat.reaction.v1.created")
+
+        with caplog.at_level(logging.WARNING, logger="gateway.platforms.google_chat"):
+            adapter._on_pubsub_message(msg)
+
+        msg.ack.assert_called_once()
+        msg.nack.assert_not_called()
+        adapter._handle_card_click.assert_not_awaited()
+        line = next(rec for rec in caplog.records if "Unrouted Pub/Sub event dropped" in rec.getMessage())
+        assert "ce-type='google.workspace.chat.reaction.v1.created'" in line.getMessage()
+        assert "keys=['chat']" in line.getMessage()
+        assert "<redacted:" in line.getMessage() and "hunter2" not in line.getMessage()
+        adapter.handle_message.assert_not_awaited()
