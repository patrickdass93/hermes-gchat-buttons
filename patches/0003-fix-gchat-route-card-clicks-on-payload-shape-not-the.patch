From 118bb3b014d56fee5c3d69fff9ea898664a086be Mon Sep 17 00:00:00 2001
From: patrickdass93 <patrickdass93@users.noreply.github.com>
Date: Mon, 23 Nov 2026 23:15:24 +0800
Subject: [PATCH 3/4] fix(gchat): route card clicks on payload shape, not the
 ce-type string
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The ce-type attribute is the primary event router, but its exact string is not
stable across Chat surfaces: on the add-ons surface it arrives EMPTY, and a
click whose ce-type misses "widget"/"card" fell through to the MESSAGE branch,
failed it, and was ACKed silently — the user's tap ended in nothing and the
gateway log stayed empty, so an empty Pub/Sub backlog could not even prove the
event had never arrived.

A click is now also recognised by payload shape (_looks_like_card_click):
type CARD_CLICKED, chat.cardClickPayload (Workspace add-on) or
chat.buttonClickedPayload (Chat add-ons envelope, whose button parameters ride
the envelope-level commonEventObject rather than the sub-dict). Every other
event that is not a MESSAGE is logged at WARNING with its ce-type and a
redacted envelope before it is acked, so an unmatched shape is visible instead
of silently dropped.
---
 plugins/platforms/google_chat/adapter.py     | 45 +++++++++
 tests/gateway/test_google_chat_card_click.py | 96 +++++++++++++++++++-
 2 files changed, 140 insertions(+), 1 deletion(-)

diff --git a/plugins/platforms/google_chat/adapter.py b/plugins/platforms/google_chat/adapter.py
index 5d3b9d47c2..fe0bd43866 100644
--- a/plugins/platforms/google_chat/adapter.py
+++ b/plugins/platforms/google_chat/adapter.py
@@ -852,6 +852,26 @@ class GoogleChatAdapter(BasePlatformAdapter):
         ctx = self._scope_ctx.copy() if self._scope_ctx is not None else contextvars.copy_context()
         ctx.run(self._handle_pubsub_message, message)
 
+    @staticmethod
+    def _looks_like_card_click(envelope: dict[str, Any]) -> bool:
+        """Payload-shape detection for CARD_CLICKED Pub/Sub events.
+
+        The ce-type attribute is the primary router (see _handle_pubsub_message),
+        but its exact string is not guaranteed to contain "widget"/"card" on every
+        Chat surface (empty on the add-ons surface); when it doesn't,
+        route on payload shape instead of acking the click into silence. Covers
+        the three observed shapes: native ``{"type": "CARD_CLICKED", ...}``,
+        Workspace add-on ``{"chat": {"cardClickPayload": ...}}``, and the Chat
+        add-ons envelope ``{"chat": {"buttonClickedPayload": ...}}`` (button
+        parameters ride ``commonEventObject.parameters`` on that surface).
+        """
+        if not isinstance(envelope, dict):
+            return False
+        if envelope.get("type") == "CARD_CLICKED":
+            return True
+        chat = envelope.get("chat")
+        return isinstance(chat, dict) and ("cardClickPayload" in chat or "buttonClickedPayload" in chat)
+
     def _handle_click_bounded(self, envelope: dict[str, Any]) -> bool:
         """Run one CARD_CLICKED handler to completion before the ack decision.
 
@@ -938,6 +958,31 @@ class GoogleChatAdapter(BasePlatformAdapter):
                 else:
                     message.nack()  # Pub/Sub redelivers; both resolve paths are idempotent
                 return
+            elif self._looks_like_card_click(envelope):
+                # Pub/Sub ce-type strings for card clicks are not stable across
+                # Chat surfaces — a click whose ce-type misses the substrings
+                # above fell through to the MESSAGE branch, failed it, and was
+                # ACKed silently (buttons show a loading bar then vanish, gateway
+                # log empty). Route on payload shape instead.
+                logger.info("[GoogleChat] CARD_CLICKED via payload-shape fallback (ce-type=%r)", ce_type)
+                if self._handle_click_bounded(envelope):
+                    message.ack()
+                else:
+                    message.nack()  # Pub/Sub redelivers; both resolve paths are idempotent
+                return
+            elif envelope and not self._extract_message_payload(envelope, ce_type):
+                # Non-MESSAGE, non-click event shape — log before the silent ack so an
+                # unmatched shape stays visible (a silent ack here turned a one-line
+                # routing fix into a multi-session debug).
+                try:
+                    from agent.redact import redact_sensitive_text
+                    dump = redact_sensitive_text(json.dumps(envelope))
+                except Exception:
+                    dump = "<redact filter unavailable>"
+                logger.warning("[GoogleChat] Unrouted Pub/Sub event dropped: ce-type=%r keys=%s payload=%s",
+                               ce_type, list(envelope.keys()), dump[:2000])
+                message.ack()
+                return
             else:
                 prepared = self._prepare_inbound(envelope, ce_type)
                 if prepared is not None:
diff --git a/tests/gateway/test_google_chat_card_click.py b/tests/gateway/test_google_chat_card_click.py
